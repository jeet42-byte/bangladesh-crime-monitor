# Normalise line endings so the repo is identical on Windows, macOS and the
# Ubuntu runner that executes the ingest workflow.
* text=auto eol=lf

# Shell scripts and workflow files must keep LF or they fail on Linux.
*.sh text eol=lf
*.yml text eol=lf
*.sql text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.ico binary
