# ---------------------------------------------------------------------------
# Bangladesh Crime Monitor - backend environment
# Copy to .env for local development. Never commit the filled-in .env.
# ---------------------------------------------------------------------------

# Neon connection string. Use the POOLED endpoint (host contains "-pooler")
# for the API. The driver prefix must be postgresql+asyncpg://
# Note: strip any "?sslmode=require" query string - asyncpg does not accept it;
# TLS is negotiated by app/db/database.py instead.
DATABASE_URL=postgresql+asyncpg://neondb_owner:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb

# Shared secret sent by the scraper as the X-Ingest-Key header.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
INGEST_API_KEY=change-me-to-a-long-random-string

# Google AI Studio key for Gemini Flash (free tier).
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-flash-lite-latest

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,https://bangladesh-crime-monitor.vercel.app

# Optional: Meta Graph API page token used by the Facebook scraper.
# Leave blank to make fb_scraper fall back to public RSS mirrors.
FB_PAGE_ACCESS_TOKEN=

# Runtime tuning
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signs session tokens and keys the one-time-code HMAC. REQUIRED in production:
# without it the app generates a random key per process, so sessions break on
# every restart and across instances.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set false to close signups without redeploying the frontend.
ALLOW_REGISTRATION=true

# Owner account, seeded on startup. The password is hashed with Argon2id
# before it reaches the database and is never logged.
OWNER_EMAIL=
OWNER_USERNAME=ahnaf
OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Email delivery (verification codes)
# ---------------------------------------------------------------------------
# Resend is preferred: 3,000/month free and a plain HTTPS API, which matters
# because Render's free tier blocks outbound SMTP.
RESEND_API_KEY=
EMAIL_FROM=Bangladesh Crime Monitor <onboarding@resend.dev>

# Alternative: your own SMTP server or a Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# Local testing only. Writes verification codes to the log instead of sending
# them, which makes "check your inbox" untrue - refused unless set explicitly.
ALLOW_CONSOLE_EMAIL=false
